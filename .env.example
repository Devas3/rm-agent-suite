# ---- Neon (Postgres) ----
# Connection string from Neon dashboard:
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
NEON_DATABASE_URL=

# ---- Aiven Apache Kafka (official confluent-kafka) ----
KAFKA_BOOTSTRAP_SERVERS=kafka-randomnumber-username-75b8.b.provider.com:port
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=certificate_location
KAFKA_CONSUMER_GROUP=rm-agent-consumer-group

# ---- CDC poller (reads Neon changes & publishes to Kafka) ----
CDC_POLL_INTERVAL_SECONDS=10
CDC_CHECKPOINT_PATH=./data/cdc_checkpoints.json

# ---- Upstash Redis (REST) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- MongoDB Atlas ----
ATLAS_URI=
ATLAS_DB=risk_agent

# ---- LLM (Groq) ----
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL_NAME=llama-3.3-70b-versatile

# ---- Local Phoenix observability ----
PHOENIX_ENABLED=false
PHOENIX_PROJECT_NAME=rm-agent
PHOENIX_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_API_KEY=

# ---- Risk scoring weights (used in Phase 3) ----
RISK_SCORE_THRESHOLD=0.65
DEPOSIT_DECLINE_WEIGHT=0.35
WIRE_DECLINE_WEIGHT=0.25
DAYS_SINCE_CONTACT_WEIGHT=0.20
CD_MATURITY_PROXIMITY_WEIGHT=0.20

# ---- Gateway API (used in Phase 4) ----
GATEWAY_JWT_SECRET=change_me_to_a_random_32_character_secret_string
GATEWAY_TOKEN_EXPIRY_MINUTES=480
